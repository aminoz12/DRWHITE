# ─── Shopify Storefront ──────────────────────────────────────────────────
# Your *.myshopify.com domain (back-office / Storefront API host).
SHOPIFY_STORE_DOMAIN=dr-white-5537.myshopify.com
# Storefront API access token (Settings → Apps → Develop apps → Storefront API).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Domain that serves Shopify checkout + customer account login. Leave blank to
# use SHOPIFY_STORE_DOMAIN (the .myshopify.com pages always work, but show an
# unbranded URL at payment time). RECOMMENDED branded setup — cliniwhite.com
# stays on Vercel, Shopify gets a subdomain:
#   1. DNS (where cliniwhite.com's DNS lives): add CNAME
#        shop.cliniwhite.com → shops.myshopify.com
#   2. Shopify admin → Settings → Domains → "Connect existing domain" →
#      shop.cliniwhite.com → wait for SSL, then "Set as primary".
#   3. Set this to shop.cliniwhite.com (here AND in Vercel env settings).
# Do NOT point it at a domain Shopify doesn't serve (drwhitecare.com is dead).
NEXT_PUBLIC_SHOPIFY_CHECKOUT_DOMAIN=

# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cliniwhite.com

# ─── Analytics & Pixels (optional — each loads only when its ID is set) ───
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
