# ─── Shopify Storefront ──────────────────────────────────────────────────
# Your *.myshopify.com domain (back-office / Storefront API host).
SHOPIFY_STORE_DOMAIN=dr-white-5537.myshopify.com
# Storefront API access token (Settings → Apps → Develop apps → Storefront API).
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Domain that serves the working checkout. Leave blank to use SHOPIFY_STORE_DOMAIN
# (the .myshopify.com checkout always works). Set this ONLY if you have a
# verified custom checkout domain — do NOT point it at drwhitecare.com (dead).
NEXT_PUBLIC_SHOPIFY_CHECKOUT_DOMAIN=

# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cliniwhite.com

# ─── Analytics & Pixels (optional — each loads only when its ID is set) ───
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
